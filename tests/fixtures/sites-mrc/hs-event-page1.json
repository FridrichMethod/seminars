7d68?resourceVersion=id%3A64611"},"working-copy":{"href":"https:\/\/mrc.stanford.edu\/jsonapi\/node\/hs_event\/1c95f9c5-e228-4548-bbe7-896f21c87d68?resourceVersion=rel%3Aworking-copy"}},"attributes":{"status":true,"title":"Tadashi Tokieda: Surprises from rubbing the wrong way","changed":"2026-10-23T20:35:57+00:00","path":{"alias":"\/events\/tadashi-tokieda-surprises-rubbing-wrong-way","pid":60371,"langcode":"en"},"body":{"value":"\u003Cp\u003EIf planning to attend, please \u003Ca href=\u0022https:\/\/forms.gle\/4CqM4HMNT7zAPan56\u0022\u003Esubmit an RSVP here.\u003C\/a\u003E\u003C\/p\u003E\u003Cp\u003EFriction, stickiness, jamming . . . Don\u2019t we frown on these conditions as spoilers of life? This lecture, however, will perform baffling experiments that pop out of these conditions, and probe their subtle physics via simple mathematics. You\u2019ll be able to enjoy many of the experiments with friends and family as easy magic.\u003C\/p\u003E\u003Cp\u003ETadashi Tokieda is starting his 10th year as a member of the Stanford math department, after vagabonding across careers \u2014 painter, philologist, precarious plumber, physicist. He likes to collect counter\u2011intuitive phenomena which he discovers, designs, or learns about from others, and to share them in outreach, e.g. via the YouTube channel Numberphile. T^2 spoke in that capacity at the quadrennial International Congress of Mathematicians 2018, 2022, 2026.\u003C\/p\u003E\u003Cp\u003EYou can find more information about speaker Tadashi Tokieda on the \u003Ca href=\u0022https:\/\/mathematics.stanford.edu\/search?search=tadashi+tokieda\u0022\u003EStanford Math Department website\u003C\/a\u003E.\u003C\/p\u003E","format":"basic_html","processed":"\u003Cp\u003EIf planning to attend, please \u003Ca href=\u0022https:\/\/forms.gle\/4CqM4HMNT7zAPan56\u0022\u003Esubmit an RSVP here.\u003C\/a\u003E\u003C\/p\u003E\u003Cp\u003EFriction, stickiness, jamming . . . Don\u2019t we frown on these conditions as spoilers of life? This lecture, however, will perform baffling experiments that pop out of these conditions, and probe their subtle physics via simple mathematics. You\u2019ll be able to enjoy many of the experiments with friends and family as easy magic.\u003C\/p\u003E\u003Cp\u003ETadashi Tokieda is starting his 10th year as a member of the Stanford math department, after vagabonding across careers \u2014 painter, philologist, precarious plumber, physicist. He likes to collect counter\u2011intuitive phenomena which he discovers, designs, or learns about from others, and to share them in outreach, e.g. via the YouTube channel Numberphile. T^2 spoke in that capacity at the quadrennial International Congress of Mathematicians 2018, 2022, 2026.\u003C\/p\u003E\u003Cp\u003EYou can find more information about speaker Tadashi Tokieda on the \u003Ca href=\u0022https:\/\/mathematics.stanford.edu\/search?search=tadashi+tokieda\u0022\u003EStanford Math Department website\u003C\/a\u003E.\u003C\/p\u003E","summary":""},"field_hs_event_admission":null,"field_hs_event_date":{"value":"2026-11-13T03:30:00+00:00","end_value":"2026-11-13T05:00:00+00:00","duration":90,"rrule":null,"rrule_index":null,"timezone":""},"field_hs_event_experience":null,"field_hs_event_instances":[],"field_hs_event_link":{"uri":"https:\/\/drive.google.com\/file\/d\/1SB9c10eKOfYfny04JLgdRKDGrkE-jhqE\/view?usp=sharing","title":"Event Poster","options":[]},"field_hs_event_location":"CEMEX Auditorium","field_hs_event_map_link":{"uri":"https:\/\/mrc.stanford.edu\/events\/public-lectures","title":"Return to Public Lectures Overview","options":[]},"field_hs_event_registration":null,"field_hs_event_sponsor":null,"field_hs_event_stream":null,"field_hs_event_stream_info":null},"relationships":{"field_hs_event_audience":{"data":[],"links":{"related":{"href":"https:\/\/mrc.stanford.edu\/jsonapi\/node\/hs_event\/1c95f9c5-e228-4548-bbe7-896f21c87d68\/field_hs_event_audience?resourceVersion=id%3A64611"},"self":{"href":"https:\/\/mrc.stanfor